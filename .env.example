# Supabase: get these from your project at supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key: used server-side only (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: any OpenAI-compatible provider. Leave unset to use the built-in parsers.
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
